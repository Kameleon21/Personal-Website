---
import '../styles/global.css';
import '../styles/hamburger.css';
import BackToTop from '../components/BackToTop.astro';

const { title = "Kamil Rogozinski - Portfolio", description = "Personal portfolio and blog of Kamil Rogozinski" } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/x-icon" sizes="16x16 32x32 48x48" href={`${import.meta.env.BASE_URL}favicon.ico`} />
		<link rel="icon" type="image/svg+xml" sizes="any" href={`${import.meta.env.BASE_URL}favicon.svg`} />
		<link rel="apple-touch-icon" sizes="180x180" href={`${import.meta.env.BASE_URL}apple-touch-icon.png`} />
		<meta name="generator" content={Astro.generator} />
		<meta name="theme-color" content="#f7f5f0" />

		<!-- Primary Meta Tags -->
		<title>{title}</title>
		<meta name="title" content={title} />
		<meta name="description" content={description} />
		<meta name="author" content="Kamil Rogozinski" />
		<meta name="keywords" content="web developer, full stack developer, astro, react, typescript, portfolio" />

		<!-- Open Graph / Facebook -->
		<meta property="og:type" content="website" />
		<meta property="og:url" content="https://kameleon21.github.io/Personal-Website/" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content="https://kameleon21.github.io/Personal-Website/images/og-image.jpg" />
		<meta property="og:site_name" content="Kamil Rogozinski Portfolio" />

		<!-- Twitter -->
		<meta property="twitter:card" content="summary_large_image" />
		<meta property="twitter:url" content="https://kameleon21.github.io/Personal-Website/" />
		<meta property="twitter:title" content={title} />
		<meta property="twitter:description" content={description} />
		<meta property="twitter:image" content="https://kameleon21.github.io/Personal-Website/images/og-image.jpg" />

		<!-- Canonical URL -->
		<link rel="canonical" href="https://kameleon21.github.io/Personal-Website/" />

		<!-- Preconnect for performance -->
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

		<!-- Typography -->
		<link
			href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;700&family=JetBrains+Mono:wght@400;500;700&display=swap"
			rel="stylesheet"
		>
	</head>
	<body class="font-sans flex flex-col min-h-screen bg-paper text-ink dot-grid">
		<slot />
		<BackToTop />

		<!-- Global reveal + scan line observer -->
		<script>
			function initRevealAnimations() {
				if (document.documentElement.dataset.revealInit === 'true') return;
				document.documentElement.dataset.revealInit = 'true';

				const revealElements = document.querySelectorAll('.reveal');
				const scanElements = document.querySelectorAll('.section-scan');

				const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
				if (prefersReducedMotion || !('IntersectionObserver' in window)) {
					revealElements.forEach((element) => element.classList.add('visible'));
					scanElements.forEach((element) => element.classList.add('scanned'));
					return;
				}

				if (!revealElements.length && !scanElements.length) return;

				const revealObserver = new IntersectionObserver(
					(entries) => {
						entries.forEach((entry) => {
							if (!entry.isIntersecting) return;
							entry.target.classList.add('visible');
							revealObserver.unobserve(entry.target);
						});
					},
					{
						threshold: 0.08,
						rootMargin: '0px 0px -8% 0px'
					}
				);

				revealElements.forEach((element) => revealObserver.observe(element));

				if (scanElements.length) {
					const scanObserver = new IntersectionObserver(
						(entries) => {
							entries.forEach((entry) => {
								if (!entry.isIntersecting) return;
								entry.target.classList.add('scanned');
								scanObserver.unobserve(entry.target);
							});
						},
						{ threshold: 0.1, rootMargin: '0px 0px -5% 0px' }
					);
					scanElements.forEach((element) => scanObserver.observe(element));
				}
			}

			if ('requestIdleCallback' in window) {
				window.requestIdleCallback(initRevealAnimations, { timeout: 200 });
			} else {
				initRevealAnimations();
			}
		</script>
	</body>
</html>
