---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import workData from '../data/work.json';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const home = `${base}/`;
const projects = `${base}/#projects`;
const blog = `${base}/blog`;
const deploymentCount = workData.deployments.length;
---

<Layout
  title="404 · service not found — Kamil Rogozinski"
  description="Nothing is listening at this URL. The rest of the system is healthy — head back to the portfolio, projects or blog."
  noindex
>
  <Header />
  <main class="w-full max-w-[1100px] mx-auto px-5 sm:px-10 pt-10 sm:pt-14 pb-16 sm:pb-20" data-not-found data-base={base}>
    <div class="flex flex-wrap justify-between gap-x-4 gap-y-1.5 font-mono text-[11px] text-faint mb-[26px]">
      <span>// incident <span class="text-accent">INC-404</span> · severity: low · blast radius: one url</span>
      <span><span data-nf-opened></span>status: investigating</span>
    </div>

    <div class="grid min-[861px]:grid-cols-[minmax(0,.92fr)_minmax(0,1.08fr)] gap-6 items-center">
      <div>
        <div class="section-label">SVC / ???</div>
        <h1 class="font-bold text-[40px] min-[861px]:text-[52px] leading-[1.02] tracking-[-1.2px] mt-2.5 mb-4">
          404 <span class="text-accent">·</span> service<br />not found
        </h1>
        <p class="text-[15px] leading-[1.65] text-muted max-w-[430px] mb-[22px]">
          Nothing is listening at <code class="path-chip" data-nf-path>this url</code>. The rest of the system is
          healthy — this one cable just isn't plugged into anything.
        </p>
        <div class="flex flex-wrap gap-2.5 items-center">
          <a href={home} class="btn-retry group">
            <span class="inline-block transition-transform duration-500 group-hover:-rotate-[200deg] motion-reduce:transition-none" aria-hidden="true">↻</span>
            retry <small class="font-mono text-[11px] opacity-80">→ /</small>
          </a>
          <a href={projects} class="btn-route">GET /projects<span>200</span></a>
          <a href={blog} class="btn-route">GET /blog<span>200</span></a>
        </div>
      </div>

      <div class="nf-frame">
        <div class="nf-stage" aria-hidden="true" data-nf-stage>
          <svg class="nf-wires" data-nf-wires></svg>
          <div class="nn nn-root" data-n="root">
            <div class="font-bold text-base tracking-[-0.3px]">KAMIL ROGOZINSKI</div>
            <div class="font-mono text-[10px] text-inkmuted mt-1">core service · v25.9</div>
            <span class="inline-block font-mono text-[9.5px] font-bold bg-mint text-ink rounded-full px-[9px] py-0.5 mt-[9px]">● HEALTHY</span>
          </div>
          <a class="nn nn-link" data-n="proj" href={projects} tabindex="-1">
            <div class="nn-label">SVC / PROJECTS</div>
            <div class="nn-title">/projects</div>
            <div class="nn-status text-ghgreen">● 200 · {deploymentCount} deployments</div>
          </a>
          <a class="nn nn-link" data-n="blog" href={blog} tabindex="-1">
            <div class="nn-label">SVC / BLOG</div>
            <div class="nn-title">/blog</div>
            <div class="nn-status text-ghgreen">● 200 · writing</div>
          </a>
          <div class="nn nn-dead" data-n="dead">
            <span class="nn-x">!</span>
            <div class="nn-label">SVC / UNKNOWN</div>
            <div class="nn-title" data-nf-path>this url</div>
            <div class="nn-status">● 404 · no upstream</div>
          </div>
        </div>
      </div>
    </div>

    <div class="node-card overflow-hidden mt-[34px]">
      <div class="dark-bar relative px-4 py-2.5 font-mono text-[11px]">
        <span class="flex gap-1.5 flex-none" aria-hidden="true">
          <i class="light bg-[#e0684a]"></i>
          <i class="light bg-hire"></i>
          <i class="light bg-mint"></i>
        </span>
        <span class="hidden sm:block absolute inset-x-[120px] text-center truncate pointer-events-none">/var/log/edge — tail -f</span>
        <span class="ml-auto font-bold text-[9.5px] bg-accent text-white rounded-full px-2 py-0.5">SEV-4</span>
      </div>
      <div class="log bg-ink text-[#d8d0c0] font-mono text-[11px] sm:text-[12px] leading-[1.85] px-3.5 py-3 sm:px-[18px] sm:pt-3.5 sm:pb-4" data-nf-log>
        <span class="block text-[#f2ecdf] mb-1"><span class="text-mint">$</span> tail -f /var/log/edge/incident.log</span>
        <div class="ln">
          <span class="t" data-nf-stamp></span><span class="lv-e">GET</span>
          <span class="msg"><span class="path" data-nf-path>this url</span> → <b>404 Not Found</b> · 3ms</span>
        </div>
        <div class="ln">
          <span class="t" data-nf-stamp></span><span class="text-hire">router</span>
          <span class="msg">no upstream matches <span class="path" data-nf-path>this url</span></span>
        </div>
        <div class="ln">
          <span class="t" data-nf-stamp></span><span class="text-mint">health</span>
          <span class="msg">kamil.core 200 · /projects 200 · /blog 200</span>
        </div>
        <div class="ln" data-nf-hint hidden>
          <span class="t" data-nf-stamp></span><span class="text-[#94b9da]">hint</span>
          <span class="msg" data-nf-hint-msg></span>
        </div>
        <div class="ln">
          <span class="t" data-nf-stamp></span><span class="text-mint">action</span>
          <span class="msg">retry → <a href={home}>/</a> <span class="t">(GET is idempotent — safe to retry)</span></span>
        </div>
        <span class="cursor" aria-hidden="true"></span>
      </div>
    </div>
  </main>
  <Footer />
</Layout>

<style>
  .path-chip {
    font: 13px 'JetBrains Mono', monospace;
    color: #1a1712;
    background: #fff;
    border: 1px solid #d8d4c8;
    border-radius: 4px;
    padding: 1px 6px;
    word-break: break-all;
  }

  /* ── Actions ── */
  .btn-retry {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 12px 20px;
    font-weight: 700;
    font-size: 15px;
    color: #fff;
    background: #c2401b;
    border: 2px solid #1a1712;
    border-radius: 9px;
    box-shadow: 6px 6px 0 rgba(26, 23, 18, 0.15);
    transition: transform 0.12s, box-shadow 0.12s, background-color 0.15s;
  }
  .btn-retry:hover { background: #1a1712; }
  .btn-retry:active {
    transform: translate(2px, 2px);
    box-shadow: 2px 2px 0 rgba(26, 23, 18, 0.2);
  }
  .btn-route {
    font: 700 12px 'JetBrains Mono', monospace;
    padding: 10px 14px;
    background: #fff;
    border: 2px solid #1a1712;
    border-radius: 8px;
    transition: background-color 0.15s, color 0.15s;
  }
  .btn-route span {
    margin-left: 6px;
    font-weight: 400;
    color: #2da44e;
  }
  .btn-route:hover { background: #1a1712; color: #f7f5f0; }
  .btn-route:hover span { color: #3fdd8f; }

  /* ── Severed-cable diagram ──
     Nodes are placed in CSS (so the no-JS state is laid out too); the script
     reads their boxes and draws the cables. Below 460px of stage width the
     diagram turns vertical: root on top, a trunk of cables down the left. */
  .nf-frame { container-type: inline-size; }
  .nf-stage {
    position: relative;
    height: 350px;
  }
  @container (max-width: 459px) {
    .nf-stage { height: 450px; }
  }
  .nf-wires {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    pointer-events: none;
  }

  .nn {
    position: absolute;
    width: 200px;
    padding: 12px 15px;
    background: #fff;
    border: 2px solid #1a1712;
    border-radius: 12px;
    box-shadow: 4px 4px 0 rgba(26, 23, 18, 0.12);
    transform: translate(-50%, -50%);
  }
  .nn-label {
    font: 9px 'JetBrains Mono', monospace;
    letter-spacing: 0.12em;
    color: #c2401b;
  }
  .nn-title {
    margin: 3px 0 4px;
    font-weight: 700;
    font-size: 15px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .nn-status {
    margin-top: 6px;
    padding-top: 6px;
    font: 10px 'JetBrains Mono', monospace;
    border-top: 1px dashed #d8d4c8;
  }
  .nn-root {
    width: 190px;
    padding: 14px 12px;
    text-align: center;
    color: #f7f5f0;
    background: #1a1712;
    box-shadow: 6px 6px 0 rgba(26, 23, 18, 0.15);
  }
  .nn-link { transition: translate 0.15s, box-shadow 0.15s; }
  .nn-link:hover {
    translate: 0 -3px;
    box-shadow: 6px 8px 0 rgba(26, 23, 18, 0.18);
  }
  .nn-dead {
    color: #6b6357;
    background: #efece4;
    border-style: dashed;
    border-color: #8a8578;
    box-shadow: none;
    rotate: 2.5deg;
  }
  .nn-dead .nn-label { color: #8a8578; }
  .nn-dead .nn-title {
    text-decoration: line-through 2px rgba(194, 64, 27, 0.6);
  }
  .nn-dead .nn-status {
    font-weight: 700;
    color: #c2401b;
    border-top-color: #cfc9bb;
  }
  .nn-x {
    position: absolute;
    right: -11px;
    top: -11px;
    display: grid;
    place-items: center;
    width: 22px;
    height: 22px;
    font: 700 12px 'JetBrains Mono', monospace;
    color: #fff;
    background: #c2401b;
    border: 2px solid #1a1712;
    border-radius: 50%;
  }

  [data-n='root'] { left: 100px; top: 46%; }
  [data-n='proj'] { left: calc(100% - 106px); top: 14%; }
  [data-n='blog'] { left: calc(100% - 106px); top: 46%; }
  [data-n='dead'] { left: calc(100% - 118px); top: 82%; }
  @container (max-width: 459px) {
    [data-n='root'] { left: 95px; top: 42px; }
    [data-n='proj'],
    [data-n='blog'],
    [data-n='dead'] { left: calc(50% + 40px); width: calc(100% - 88px); }
    [data-n='proj'] { top: 168px; }
    [data-n='blog'] { top: 270px; }
    [data-n='dead'] { top: 384px; }
  }

  /* SVG is filled by the script, so its children need :global() */
  .nf-wires :global(.wire) {
    fill: none;
    stroke: #3c3a34;
    stroke-width: 2.5;
    stroke-linecap: round;
  }
  .nf-wires :global(.wire-dead) { stroke: #a39d8f; }
  .nf-wires :global(.plug) { fill: #1a1712; }
  .nf-wires :global(.plug-dead) { fill: #8a8578; }
  .nf-wires :global(.pulse) { fill: #3fdd8f; }
  .nf-wires :global(.cut-label) {
    font: 700 9px 'JetBrains Mono', monospace;
    letter-spacing: 0.06em;
    fill: #c2401b;
  }
  .nf-wires :global(.fray line) {
    stroke: #3c3a34;
    stroke-width: 1.6;
    stroke-linecap: round;
  }
  .nf-wires :global(.sparks line) {
    stroke-width: 2;
    stroke-linecap: round;
    opacity: 0.8;
  }
  .nf-wires :global(.s1) { stroke: #f0b429; }
  .nf-wires :global(.s2) { stroke: #3fdd8f; }
  .nf-wires :global(.s3) { stroke: #c2401b; }
  .nf-wires :global(.glow) { fill: #f0b429; opacity: 0; }

  @media (prefers-reduced-motion: no-preference) {
    .nf-wires :global(.sparks line) {
      opacity: 0;
      animation: nf-spark 2.6s infinite;
    }
    .nf-wires :global(.sparks line:nth-child(2)) { animation-delay: 0.06s; }
    .nf-wires :global(.sparks line:nth-child(3)) { animation-delay: 0.12s; }
    .nf-wires :global(.sparks line:nth-child(4)) { animation-delay: 0.03s; }
    .nf-wires :global(.sparks line:nth-child(5)) { animation-delay: 0.1s; }
    .nf-wires :global(.sparks line:nth-child(6)) { animation-delay: 0.16s; }
    .nf-wires :global(.glow) { animation: nf-glow 2.6s infinite; }
  }
  @keyframes nf-spark {
    0%, 70% { opacity: 0; transform: scale(0.3); }
    72% { opacity: 1; transform: scale(1); }
    78% { opacity: 0.9; transform: scale(1.25); }
    84%, 100% { opacity: 0; transform: scale(1.5); }
  }
  @keyframes nf-glow {
    0%, 70% { opacity: 0; r: 2; }
    74% { opacity: 0.55; r: 9; }
    86%, 100% { opacity: 0; r: 13; }
  }

  /* ── Incident log ── */
  .light {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    border: 1px solid rgba(0, 0, 0, 0.35);
  }
  .ln {
    display: grid;
    grid-template-columns: 52px minmax(0, 1fr);
    gap: 8px;
    margin-bottom: 4px;
    line-height: 1.6;
  }
  .ln[hidden] { display: none; }
  .ln > .t { display: none; }
  @media (min-width: 640px) {
    .ln {
      grid-template-columns: 104px 62px minmax(0, 1fr);
      gap: 10px;
      margin-bottom: 0;
      line-height: inherit;
    }
    .ln > .t { display: block; }
  }
  .t { color: #5a5346; }
  .lv-e { color: #ee8575; font-weight: 700; }
  .msg { word-break: break-all; }
  .path {
    color: #f2ecdf;
    background: #3a3428;
    padding: 0 4px;
    border-radius: 3px;
  }
  .log :global(a) { color: #3fdd8f; text-decoration: underline; }
  .log :global(a:hover) { color: #f2ecdf; }

  /* Lines tail in once the script has filled them */
  [data-animate] .ln {
    opacity: 0;
    translate: 0 3px;
    transition: opacity 0.25s, translate 0.35s cubic-bezier(0.22, 1, 0.36, 1);
  }
  [data-animate] .ln.in { opacity: 1; translate: 0 0; }

  .cursor {
    display: inline-block;
    width: 7px;
    height: 14px;
    margin-top: 4px;
    vertical-align: -2px;
    background: #f0b429;
    animation: nf-blink 1.1s steps(2, start) infinite;
  }
  @keyframes nf-blink {
    to { visibility: hidden; }
  }

  @media (prefers-reduced-motion: reduce) {
    .cursor { animation: none; }
    .btn-retry,
    .btn-route,
    .nn-link { transition: none; }
  }
</style>

<script>
  import { initNotFound } from '../scripts/not-found';

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initNotFound, { once: true });
  } else {
    initNotFound();
  }
</script>
