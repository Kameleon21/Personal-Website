---
const base = import.meta.env.BASE_URL;
const mono = "font-family:'Fira Code',monospace;";
const meta = `${mono}font-size:12px;line-height:1.8;letter-spacing:.025em;color:var(--muted);`;
const chip = `${mono}font-size:12px;padding:7px 10px;border:1px solid var(--border);border-radius:3px;display:inline-flex;align-items:center;gap:7px;`;
const link = `${mono}font-size:12px;color:var(--muted);text-decoration:none;`;
const section = 'padding:90px 0;border-top:1px solid var(--border);scroll-margin-top:110px;';
const title = 'font-size:clamp(34px,4vw,60px);font-weight:800;letter-spacing:-.055em;line-height:1.15;margin:20px 0 32px;';
const input = `${mono}box-sizing:border-box;width:100%;padding:15px;background:var(--surface);border:1px solid var(--border);border-radius:5px;color:var(--text);font-size:12px;`;
const sections = ['about','experience','projects','stack','blog','contact'];
const keys = ['A','S','D','F','G','H'];
const stack = ['Java','Spring Boot','Go','TypeScript','JavaScript','Angular','Python','MySQL','REST APIs','Docker','OpenShift','Git','CI/CD','Agile'];
const projects = [
 {name:'Oku',path:'~/projects/oku',kind:'CLI / TUI',description:'Your next chapter, one command away. A book tracker for people who live in the terminal.',tags:['Go','SQLite','GraphQL'],repo:'oku',url:null},
 {name:'FirstDevJob',path:'~/projects/firstdevjob',kind:'WEB APP',description:'The first job is the hardest query. An Irish job board helping junior developers find their start.',tags:['TypeScript','Next.js','Convex'],repo:'firstdevjob',url:'https://www.first-dev-job.com/'},
 {name:'CE Equipment',path:'~/clients/ce-equipment',kind:'CLIENT SITE',description:'A fast, considered home for an Irish CE marking consultancy. Shipped to an actual paying human.',tags:['Astro','React','TypeScript'],repo:'CE-Equipment-Solutions',url:'https://ceequipmentsolutions.com/'}
];
---
<!doctype html>
<html lang="en" style="scroll-behavior:smooth;">
<head>
 <meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/>
 <title>Kamil Rogozinski — Software, thoughtfully built.</title>
 <meta name="description" content="Kamil Rogozinski. Software engineer at Citi Dublin, building useful things with Java, Go and TypeScript."/>
 <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`}/>
 <link rel="preconnect" href="https://fonts.googleapis.com"/><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
 <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=Fira+Code:wght@400;500&display=swap" rel="stylesheet"/>
</head>
<body style="--bg:#f6f4ef;--surface:#eeece6;--text:#1a1a1f;--muted:#696974;--accent:#d9436f;--success:#228352;--border:#1a1a1f20;margin:0;background:var(--bg);color:var(--text);font-family:'Manrope',sans-serif;line-height:1.65;">
 <header id="header" style="position:fixed;inset:0 0 auto;z-index:30;display:flex;align-items:center;justify-content:space-between;padding:20px 5%;background:var(--bg);border-bottom:1px solid var(--border);gap:20px;">
  <a href="#about" style="font-size:20px;font-weight:800;letter-spacing:-1px;color:var(--text);text-decoration:none;">kamil<span style="color:var(--accent);">.</span>kbd</a>
  <nav id="header-nav" aria-label="Main navigation" style="display:flex;gap:28px;">{['experience','projects','stack','blog'].map(s=><a href={`#${s}`} style={link}>/{s}</a>)}</nav>
  <button id="theme-toggle" type="button" aria-label="Switch to dark theme" aria-pressed="true" style={`${mono}border:1px solid var(--border);border-radius:30px;color:var(--text);background:transparent;padding:8px 13px;cursor:pointer;font-size:11px;display:flex;gap:10px;align-items:center;`}><span style="width:11px;height:11px;background:var(--text);border-radius:50%;display:block;"></span><span id="theme-label">light</span></button>
 </header>
 <main id="content" style="width:90%;max-width:1400px;margin:0 auto;">
  <section id="about" data-section="A" style="position:relative;padding:140px 0 0;scroll-margin-top:100px;">
   <div style={`${meta}display:flex;justify-content:space-between;gap:20px;flex-wrap:wrap;`}><span><span style="color:var(--accent);">keycap [A]</span> · SOFTWARE ENGINEER / DUBLIN, IE</span><span>PORTFOLIO — VOL. 2026</span></div>
   <h1 style="font-size:clamp(43px,9.6vw,146px);font-weight:800;letter-spacing:-.075em;line-height:1.12;margin:24px 0 28px;">Kamil Rogozinski<span style="color:var(--accent);">.</span></h1>
   <div data-responsive-grid="hero" style="display:grid;grid-template-columns:1fr 1fr;gap:30px;border-top:1px solid var(--border);padding-top:24px;">
    <p style="font-size:clamp(20px,2.25vw,32px);line-height:1.4;letter-spacing:-1px;margin:0;">Thoughtful software.<br/>A little personality in production.</p>
    <div style="justify-self:end;"><p style={`${meta}margin:0 0 14px;`}>Software engineer @ Citi Dublin · v25.9</p><div style="display:flex;gap:7px;flex-wrap:wrap;"><span style={`${chip}color:var(--success);`}>● HEALTHY</span><span style={`${chip}color:var(--success);`}>HIREABLE</span><span style={chip}>JAVA · GO · TS</span></div></div>
   </div>
   <div id="keyboard-slot" style="position:relative;height:500px;margin-top:24px;">
    <aside id="keyboard-panel" aria-label="Mechanical keyboard. Scroll to assemble. A, S, D, F, G and H navigate the page." style="position:absolute;inset:0;z-index:5;pointer-events:none;">
     <div id="scene" style="position:absolute;inset:0;"></div>
     <p id="scene-fallback" hidden style={`${meta}position:absolute;top:45%;left:20%;right:20%;text-align:center;`}>The 3D preview is unavailable. Explore using the section links below.</p>
     <div id="dock-label" hidden style={`${meta}position:absolute;bottom:8px;left:16px;font-size:10px;`}>[A] about</div>
    </aside>
    <div id="scene-caption" style={`${meta}position:absolute;left:0;top:45%;font-size:11px;max-width:145px;`}><span style="color:var(--accent);">FIG. 01</span><br/>The daily driver.<br/>61 keys. Many opinions.</div>
    <div id="scene-bottom" style={`${meta}position:absolute;right:0;top:45%;font-size:11px;width:150px;`}><span id="assembly-label">ASSEMBLING</span><div style="height:2px;background:var(--border);margin:12px 0;"><div id="assembly-bar" style="height:2px;background:var(--accent);width:0%;"></div></div><span id="assembly-percent">0%</span><span style="float:right;">19.05 mm</span></div>
   </div>
   <div data-responsive-grid="hero-foot" style="display:flex;align-items:center;justify-content:space-between;gap:24px;padding:12px 0 34px;"><a href="#experience" style={`${link}color:var(--text);`}>scroll to assemble ↓</a><nav aria-label="Keyboard shortcuts" style="display:flex;flex-wrap:wrap;gap:12px 20px;">{sections.map((s,i)=><a data-key-link={keys[i]} href={`#${s}`} style={`${link}display:flex;align-items:center;gap:7px;`}><kbd style={`${chip}padding:1px 6px;color:var(--accent);`}>{keys[i]}</kbd>{s}</a>)}</nav><span id="active-key" style={`${meta}display:none;`}>[A] about</span></div>
  </section>
  <section id="experience" data-section="S" style={section}>
   <div data-responsive-grid="section" style="display:grid;grid-template-columns:1fr 1.65fr;gap:8%;">
    <div><div style={meta}><span style="color:var(--accent);">01 / keycap [S]</span> · SVC / EXPERIENCE</div><h2 style={title}>Deploy<br/>history.</h2><p style={`${meta}max-width:240px;`}>A few good releases.<br/>0 incidents · 0 rollbacks</p></div>
    <div>
     <div style={`${meta}display:flex;justify-content:space-between;gap:15px;`}><span>2025.09 → now</span><span style="color:var(--success);">CURRENT RELEASE</span></div><h3 style="font-size:28px;letter-spacing:-1px;margin:14px 0 0;">Software Engineer</h3><p style="font-size:16px;color:var(--muted);margin:4px 0 22px;">Citi · Dublin, Ireland</p>
     {['Ships Spring Boot REST services across multiple apps','Builds modular Angular front-end components','Designs MySQL schemas for query efficiency','Deploys via Docker + OpenShift; improves CI/CD','Mentors interns: onboarding, reviews, guidance'].map(t=><p style={`${mono}font-size:12px;display:flex;gap:14px;margin:12px 0;`}><span style="color:var(--success);">+</span>{t}</p>)}
     <div style="padding:28px 0;margin-top:30px;border-top:1px solid var(--border);"><div style={meta}>2024.06 → 12</div><h3 style="font-size:21px;letter-spacing:-.6px;margin:10px 0;">SWE Intern · Citi Dublin</h3><p style="font-size:16px;color:var(--muted);margin:0;">Java + .NET, APIs, microservices, and code reviews.<br/>The internship passed its integration test. Converted to full-time.</p></div>
     <div style="padding:28px 0 0;border-top:1px solid var(--border);"><div style={meta}>2022 → 25</div><h3 style="font-size:21px;letter-spacing:-.6px;margin:10px 0;">BSc (Hons) Software Systems</h3><p style="font-size:16px;color:var(--muted);margin:0;">SETU Waterford · First Class Honours</p></div>
    </div>
   </div>
  </section>
  <section id="projects" data-section="D" style={section}>
   <div style={meta}><span style="color:var(--accent);">02 / keycap [D]</span> · BUILD / PROJECTS</div><div style="display:flex;justify-content:space-between;align-items:baseline;gap:24px;flex-wrap:wrap;"><h2 style={title}>Built. Shipped. Used.</h2><span style={meta}>3 DEPLOYMENTS / 0 SHELFWARE</span></div>
   {projects.map((p,i)=><article data-responsive-grid="project" style="display:grid;grid-template-columns:45px 1fr 1.4fr 110px;gap:24px;padding:36px 0;border-top:1px solid var(--border);align-items:start;">
    <span style={`${meta}color:var(--accent);padding-top:7px;`}>0{i+1}</span><div><span style={`${meta}font-size:10px;`}>{p.path}</span><h3 style="font-size:30px;letter-spacing:-1.2px;margin:8px 0;">{p.name}</h3><span style={meta}>{p.kind}</span></div><div><p style="font-size:16px;color:var(--muted);margin:0 0 18px;">{p.description}</p><div style="display:flex;gap:7px;flex-wrap:wrap;">{p.tags.map(t=><span style={`${chip}padding:3px 8px;font-size:11px;`}>{t}</span>)}</div></div><div style="display:flex;flex-direction:column;gap:13px;padding-top:4px;"><a href={`https://github.com/Kameleon21/${p.repo}`} target="_blank" rel="noopener noreferrer" style={`${link}color:var(--text);`}>source ↗</a>{p.url&&<a href={p.url} target="_blank" rel="noopener noreferrer" style={`${link}color:var(--accent);`}>live site ↗</a>}</div>
   </article>)}
  </section>
  <section id="stack" data-section="F" style={section}><div data-responsive-grid="section" style="display:grid;grid-template-columns:1fr 1.65fr;gap:8%;"><div><div style={meta}><span style="color:var(--accent);">03 / keycap [F]</span> · CI / STACK</div><h2 style={title}>A dependable<br/>set of tools.</h2></div><div><p style="font-size:20px;letter-spacing:-.5px;margin:0 0 28px;">All checks have passed.</p><div style="display:flex;gap:10px;flex-wrap:wrap;">{stack.map(t=><span style={`${chip}padding:12px 16px;font-size:13px;background:var(--surface);`}><span style="color:var(--success);">✓</span>{t}</span>)}</div><p style={`${meta}margin-top:24px;`}>// chosen for the job, not the conference talk.</p></div></div></section>
  <section id="blog" data-section="G" style={section}><div data-responsive-grid="section" style="display:grid;grid-template-columns:1fr 1.65fr;gap:8%;"><div><div style={meta}><span style="color:var(--accent);">04 / keycap [G]</span> · LOG / BLOG</div><h2 style={title}>Field notes.</h2></div><div><p style="font-size:24px;letter-spacing:-.6px;line-height:1.5;margin:0 0 25px;">Things I built, things I broke,<br/>and what made it into the next release.</p><p style="font-size:16px;color:var(--muted);max-width:480px;">TUIs, side projects, and lessons from real client work. A small record of figuring things out.</p><a href={`${base}blog/`} style={`${chip}padding:14px 20px;margin-top:20px;text-decoration:none;color:var(--text);`}>GET /blog →</a></div></div></section>
  <section id="contact" data-section="H" style={section}>
   <div style={meta}><span style="color:var(--accent);">05 / keycap [H]</span> · PR / CONTACT</div><h2 style="font-size:clamp(48px,8vw,116px);font-weight:800;line-height:1.15;letter-spacing:-.07em;margin:24px 0 40px;">Good things start<br/>with a <span style="color:var(--accent);">hello.</span></h2>
   <div data-responsive-grid="section" style="display:grid;grid-template-columns:1fr 1.65fr;gap:8%;">
    <div><p style={`${meta}color:var(--success);`}>⎇ Open Merge<br/>+8,542 skills · −0 red flags</p><p style="font-size:16px;color:var(--muted);max-width:300px;margin:24px 0;">A role, an idea, or a particularly good bug. My inbox is open.</p><a href="mailto:kamilrogozinski29@gmail.com" style={`${chip}padding:13px 18px;background:var(--text);color:var(--bg);text-decoration:none;`}>Merge — get in touch ↗</a><div style="display:flex;gap:24px;margin-top:25px;"><a href="https://github.com/Kameleon21" target="_blank" rel="noopener noreferrer" style={link}>GitHub ↗</a><a href="https://www.linkedin.com/in/kamil-rogozinski/" target="_blank" rel="noopener noreferrer" style={link}>LinkedIn ↗</a></div></div>
    <form id="portfolio-form" action="https://api.web3forms.com/submit" method="POST" aria-label="Contact Kamil" style="display:grid;gap:16px;"><input type="hidden" name="access_key" value="05b550d2-4a55-48ac-a936-b35068dbd9d6"/><input type="checkbox" name="botcheck" tabindex="-1" aria-hidden="true" style="display:none;"/><label style={meta}>name<input name="name" autocomplete="name" required placeholder="Ada Lovelace" style={input}/></label><label style={meta}>email<input name="email" type="email" autocomplete="email" required placeholder="ada@example.com" style={input}/></label><label style={meta}>message<textarea name="message" required rows="4" placeholder="Let's build something useful..." style={`${input}resize:vertical;`}></textarea></label><button type="submit" style={`${chip}padding:13px 20px;justify-self:start;background:transparent;color:var(--text);cursor:pointer;`}>POST /message →</button><p id="form-status" role="status" aria-live="polite" style={`${meta}margin:0;`}></p></form>
   </div>
  </section>
  <footer style={`${meta}padding:28px 0 40px;border-top:1px solid var(--border);display:flex;justify-content:space-between;gap:15px;flex-wrap:wrap;font-size:11px;`}><span>© 2026 kamil rogozinski · waterford, ireland</span><span>// built different, deploys the same</span></footer>
 </main>
 <script src="../scripts/portfolio.ts"></script>
</body></html>
