---
const base = import.meta.env.BASE_URL;
const mono = "font-family:'Fira Code',monospace;";
const meta = `${mono}font-size:11px;line-height:1.8;letter-spacing:.035em;color:var(--muted);`;
const chip = `${mono}font-size:11px;padding:7px 10px;border:1px solid var(--border);border-radius:5px;display:inline-flex;align-items:center;gap:7px;`;
const link = `${mono}font-size:12px;color:var(--muted);text-decoration:none;`;
const section = 'padding:90px 0;border-top:1px solid var(--border);scroll-margin-top:110px;';
const title = 'font-size:clamp(30px,3.2vw,46px);font-weight:800;letter-spacing:-.055em;line-height:1.15;margin:20px 0 32px;';
const input = `${mono}box-sizing:border-box;width:100%;padding:15px;background:var(--surface);border:1px solid var(--border);border-radius:5px;color:var(--text);font-size:12px;`;
const sections = ['about','experience','projects','stack','blog','contact'];
const keys = ['A','S','D','F','G','H'];
const stack = ['Java','Spring Boot','Go','TypeScript','JavaScript','Angular','Python','MySQL','REST APIs','Docker','OpenShift','Git','CI/CD','Agile'];
const projects = [
 {name:'Oku',path:'~/projects/oku',kind:'CLI / TUI',description:'Your next chapter, one command away. A book tracker for people who live in the terminal.',tags:['Go','SQLite','GraphQL'],repo:'oku',url:null},
 {name:'FirstDevJob',path:'~/projects/firstdevjob',kind:'WEB APP',description:'The first job is the hardest query. An Irish job board helping junior developers find their start.',tags:['TypeScript','Next.js','Convex'],repo:'firstdevjob',url:'https://www.first-dev-job.com/'},
 {name:'CE Equipment',path:'~/clients/ce-equipment',kind:'CLIENT SITE',description:'A fast, considered home for an Irish CE marking consultancy. Shipped to an actual paying human.',tags:['Astro','React','TypeScript'],repo:'CE-Equipment-Solutions',url:'https://ceequipmentsolutions.com/'}
];
---
<!doctype html>
<html lang="en" style="scroll-behavior:smooth;">
<head>
 <meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/>
 <title>Kamil Rogozinski — Software Engineer</title>
 <meta name="description" content="Software engineer at Citi Dublin. Java, Go, TypeScript. Building useful software, one keystroke at a time."/>
 <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`}/>
 <link rel="preconnect" href="https://fonts.googleapis.com"/><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
 <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=Fira+Code:wght@400;500&display=swap" rel="stylesheet"/>
</head>
<body style="--bg:#121215;--surface:#1a1a1f;--text:#ececf0;--muted:#9c9ca8;--accent:#e2557e;--success:#4fd18b;--border:#ffffff15;margin:0;background:var(--bg);color:var(--text);font-family:'Manrope',sans-serif;line-height:1.65;">
 <header id="header" style="position:fixed;inset:0 0 auto;z-index:20;display:flex;align-items:center;justify-content:space-between;padding:23px 4.5%;background:var(--bg);border-bottom:1px solid var(--border);gap:20px;">
  <a href="#about" aria-label="Kamil home" style="font-weight:800;font-size:20px;letter-spacing:-1px;color:var(--text);text-decoration:none;">kamil<span style="color:var(--accent);">.</span>kbd</a>
  <nav id="header-nav" aria-label="Main navigation" style="display:flex;gap:26px;margin-left:auto;margin-right:30px;">{['experience','projects','stack','blog'].map(s=><a href={`#${s}`} style={link}>/{s}</a>)}</nav>
  <button id="theme-toggle" type="button" aria-label="Switch to light theme" aria-pressed="false" style={`${mono}border:1px solid var(--border);border-radius:30px;color:var(--text);background:var(--surface);padding:8px 13px;cursor:pointer;font-size:11px;display:flex;gap:10px;align-items:center;`}><span id="theme-indicator" style="width:12px;height:12px;background:var(--text);border-radius:50%;display:block;"></span><span id="theme-label">dark</span></button>
 </header>
 <aside id="keyboard-panel" aria-label="Interactive 60 percent keyboard. Scroll to assemble; A through H navigate sections." style="position:fixed;right:0;top:80px;bottom:0;width:55%;z-index:1;pointer-events:none;">
  <div id="scene" style="position:absolute;inset:0;"></div>
  <div id="scene-caption" style={`position:absolute;top:9%;left:12%;right:9%;display:flex;justify-content:space-between;${meta}`}><span>FIG. 01 — THE DAILY DRIVER</span><span>60% / 61 KEYS</span></div>
  <div id="scene-bottom" style="position:absolute;bottom:9%;left:12%;right:9%;">
   <div style={`display:flex;justify-content:space-between;${meta}`}><span id="assembly-label">ASSEMBLY IN PROGRESS</span><span id="assembly-percent">0%</span></div>
   <div style="height:2px;background:var(--border);margin:12px 0 22px;"><div id="assembly-bar" style="height:100%;width:0%;background:var(--accent);"></div></div>
   <div style={`display:flex;justify-content:space-between;${meta}`}><span><span style="color:var(--accent);">●</span> <span id="active-key">[A] about</span></span><span>19.05 mm pitch · made to build</span></div>
  </div>
  <p id="scene-fallback" hidden style={`${meta}position:absolute;top:45%;left:15%;right:10%;`}>3D preview is unavailable on this device. Use the section keys or navigation to explore.</p>
 </aside>
 <main id="content" style="position:relative;z-index:2;width:40.5%;margin-left:4.5%;box-sizing:border-box;padding-right:4%;">
  <section id="about" data-section="A" style="min-height:100svh;display:flex;flex-direction:column;justify-content:center;box-sizing:border-box;padding:150px 0 65px;scroll-margin-top:100px;">
   <div style={meta}><span style="color:var(--accent);">keycap [A]</span> · SYS / ABOUT · online</div>
   <h1 style="font-size:clamp(42px,5.6vw,88px);line-height:1.03;font-weight:800;letter-spacing:-.065em;margin:30px 0 25px;">Kamil<br/>Rogozinski<span style="color:var(--accent);">.</span></h1>
   <p style={`${mono}font-size:12px;line-height:2;color:var(--muted);margin:0;`}>Software engineer @ <span style="color:var(--text);">Citi Dublin</span><br/><span style="color:var(--accent);">v25.9</span> · production since September '25</p>
   <p style="font-size:16px;color:var(--muted);max-width:360px;margin:26px 0;">I build software that does its job.<br/>Preferably without a 3 a.m. incident.</p>
   <div style="display:flex;flex-wrap:wrap;gap:7px;"><span style={`${chip}color:var(--success);`}>● HEALTHY</span><span style={`${chip}color:var(--success);`}>HIREABLE</span><span style={chip}>JAVA · GO · TS</span></div>
   <div style="height:1px;background:var(--border);margin:34px 0 22px;max-width:390px;"></div>
   <p style={`${meta}margin:0 0 12px;`}>// six keys. the whole story.</p>
   <nav aria-label="Keyboard section shortcuts" style="display:flex;flex-wrap:wrap;gap:10px 18px;max-width:380px;">{sections.map((s,i)=><a data-key-link={keys[i]} href={`#${s}`} style={`${link}display:flex;align-items:center;gap:7px;`}><kbd style={`${chip}padding:2px 7px;color:var(--accent);`}>{keys[i]}</kbd>{s}</a>)}</nav>
   <a href="#experience" style={`${link}margin-top:50px;`}>scroll to assemble <span style="color:var(--accent);margin-left:10px;">↓</span></a>
  </section>
  <section id="experience" data-section="S" style={section}>
   <div style={meta}><span style="color:var(--accent);">keycap [S]</span> · SVC / EXPERIENCE<br/>0 incidents · 0 rollbacks</div><h2 style={title}>Deploy history<span style="color:var(--accent);">.</span></h2>
   <div style={`${meta}display:flex;justify-content:space-between;border-bottom:1px solid var(--border);padding-bottom:15px;`}><span>experience/citi-dublin.java</span><span style="color:var(--success);">+412 −0</span></div>
   <h3 style="font-size:20px;letter-spacing:-.6px;margin:23px 0 4px;">Software Engineer</h3><div style={meta}>Citi Dublin <span style="float:right;">2025.09 → now</span></div>
   <div style="margin:24px 0 36px;">{['Ships Spring Boot REST services across multiple apps','Builds modular Angular front-end components','Designs MySQL schemas for query efficiency','Deploys via Docker + OpenShift; improves CI/CD','Mentors interns: onboarding, reviews, guidance'].map(t=><div style={`${mono}font-size:12px;line-height:1.8;display:flex;gap:13px;margin:12px 0;`}><span style="color:var(--success);">+</span><span>{t}</span></div>)}</div>
   <div style="padding:25px 0;border-top:1px solid var(--border);"><div style={meta}>2024.06 → 12</div><h3 style="font-size:18px;margin:8px 0;">SWE Intern · Citi Dublin</h3><p style="color:var(--muted);font-size:14px;margin:0;">Java + .NET, APIs, microservices, and code reviews. Passed the trial period. Came back for the full release.</p></div>
   <div style="padding:25px 0;border-top:1px solid var(--border);"><div style={meta}>2022 → 25</div><h3 style="font-size:18px;margin:8px 0;">BSc (Hons) Software Systems</h3><p style="color:var(--muted);font-size:14px;margin:0;">SETU Waterford · First Class Honours</p></div>
  </section>
  <section id="projects" data-section="D" style={section}><div style={meta}><span style="color:var(--accent);">keycap [D]</span> · BUILD / PROJECTS · shipped</div><h2 style={title}>Deployments<span style="color:var(--accent);">.</span></h2>
   {projects.map((p,i)=><article style="padding:25px;background:var(--surface);border:1px solid var(--border);border-radius:8px;margin-bottom:16px;"><div style={`${meta}display:flex;justify-content:space-between;gap:10px;`}><span>{p.path}</span><span>0{i+1}</span></div><div style="display:flex;align-items:baseline;gap:14px;margin-top:15px;"><h3 style="font-size:24px;letter-spacing:-1px;margin:0;">{p.name}</h3><span style={`${meta}font-size:10px;`}>{p.kind}</span></div><p style="font-size:14px;color:var(--muted);margin:13px 0 20px;">{p.description}</p><div style="display:flex;flex-wrap:wrap;gap:6px;">{p.tags.map(t=><span style={`${chip}font-size:10px;padding:3px 7px;`}>{t}</span>)}</div><div style="display:flex;gap:22px;margin-top:22px;"><a href={`https://github.com/Kameleon21/${p.repo}`} target="_blank" rel="noopener noreferrer" style={`${link}color:var(--text);`}>source ↗</a>{p.url&&<a href={p.url} target="_blank" rel="noopener noreferrer" style={`${link}color:var(--accent);`}>live deployment ↗</a>}</div></article>)}
  </section>
  <section id="stack" data-section="F" style={section}><div style={meta}><span style="color:var(--accent);">keycap [F]</span> · CI / STACK · 14 / 14</div><h2 style={title}>All checks<br/>have passed<span style="color:var(--success);">.</span></h2><p style="font-size:16px;color:var(--muted);margin-bottom:28px;">Tools I reach for. No dependency on hype.</p><div style="display:flex;flex-wrap:wrap;gap:10px;">{stack.map(t=><span style={`${chip}padding:10px 13px;font-size:12px;background:var(--surface);`}><span style="color:var(--success);">✓</span>{t}</span>)}</div></section>
  <section id="blog" data-section="G" style={section}><div style={meta}><span style="color:var(--accent);">keycap [G]</span> · LOG / BLOG · human-written</div><h2 style={title}>Notes from<br/>the terminal<span style="color:var(--accent);">.</span></h2><p style="color:var(--muted);font-size:16px;">Things I built, things I broke, and the lessons that survived code review. Occasionally useful. Always honest.</p><a href={`${base}blog/`} style={`${chip}margin-top:20px;padding:13px 19px;color:var(--text);text-decoration:none;`}>GET /blog →</a></section>
  <section id="contact" data-section="H" style={section}><div style={meta}><span style="color:var(--accent);">keycap [H]</span> · PR / CONTACT · ready for review</div><h2 style={title}>Let's merge<span style="color:var(--accent);">.</span></h2><div style={`${meta}color:var(--success);`}>⎇ Open Merge · +8,542 skills · −0 red flags</div><p style="color:var(--muted);font-size:16px;margin:25px 0;">Have a role, an idea, or a particularly good bug?<br/>Let's open a conversation.</p>
   <div style="display:flex;gap:24px;margin-bottom:24px;"><a href="https://github.com/Kameleon21" style={link} target="_blank" rel="noopener noreferrer">GitHub ↗</a><a href="https://www.linkedin.com/in/kamil-rogozinski/" style={link} target="_blank" rel="noopener noreferrer">LinkedIn ↗</a></div><a href="mailto:kamilrogozinski29@gmail.com" style={`${chip}background:var(--success);color:#121215;text-decoration:none;padding:13px 18px;border:0;`}>Merge — get in touch</a>
   <form id="portfolio-form" action="https://api.web3forms.com/submit" method="POST" style="margin-top:40px;display:grid;gap:16px;" aria-label="Contact Kamil"><input type="hidden" name="access_key" value="05b550d2-4a55-48ac-a936-b35068dbd9d6"/><input type="checkbox" name="botcheck" tabindex="-1" aria-hidden="true" style="display:none;"/>
    <label style={meta}>name<input name="name" autocomplete="name" required placeholder="Ada Lovelace" style={input}/></label><label style={meta}>email<input name="email" type="email" autocomplete="email" required placeholder="ada@example.com" style={input}/></label><label style={meta}>message<textarea name="message" required rows="4" placeholder="Let's build something useful..." style={`${input}resize:vertical;`}></textarea></label><button type="submit" style={`${chip}justify-self:start;background:var(--surface);color:var(--text);padding:13px 20px;cursor:pointer;`}>POST /message →</button><p id="form-status" role="status" aria-live="polite" style={`${meta}margin:0;`}></p>
   </form>
  </section>
  <footer style={`${meta}font-size:10px;padding:30px 0 40px;border-top:1px solid var(--border);`}>© 2026 kamil rogozinski · waterford, ireland<br/>// built different, deploys the same</footer>
 </main>
 <script src="../scripts/portfolio.ts"></script>
</body></html>
