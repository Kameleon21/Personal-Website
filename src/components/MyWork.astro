---
import workData from '../data/work.json';

const findProject = (title: string) =>
  workData.projects.find((item) => item.title === title);

const tokenlens = findProject('Tokenlens');
const oku = findProject('OKU');
const firstDevJob = findProject('FirstDevJob');
const ceEquipment = findProject('CE Equipment Solutions');

const deployments = [
  {
    repo: 'tokenlens/',
    kind: 'open source',
    name: 'Tokenlens',
    desc: 'See what your coding agents actually cost. A terminal dashboard for token usage and estimated spend across agents and models, with date filters, period comparisons, cached reports, themes, and JSON/CSV/SVG/PNG exports.',
    tags: ['Go', 'Bubble Tea', 'TUI', 'ccusage'],
    links: [{ label: 'view source →', href: tokenlens?.githubLink }],
  },
  {
    repo: 'oku/',
    kind: 'open source',
    name: 'Oku',
    desc: 'A book tracker that lives in your terminal. Manage a Hardcover reading library with lazygit-style modal panels, discovery search across books, authors and genres, and density modes. Built for devs who live in tmux.',
    tags: ['Go', 'Bubble Tea', 'Lip Gloss', 'TUI'],
    links: [{ label: 'view source →', href: oku?.githubLink }],
  },
  {
    repo: 'firstdevjob/',
    kind: 'platform',
    name: 'FirstDevJob',
    desc: "The job board Ireland's junior devs were missing. Curated listings that link straight to applications — no account needed to browse. Anonymous submissions, Google OAuth via Clerk, email notifications, audit trails.",
    tags: ['TypeScript', 'Clerk', 'OAuth', 'Full-stack'],
    links: [
      { label: 'view live →', href: firstDevJob?.link },
      { label: 'view source →', href: firstDevJob?.githubLink },
    ],
  },
  {
    repo: 'ce-equipment/',
    kind: 'client work',
    name: 'CE Equipment',
    desc: 'B2B consulting website built for speed. Responsive, high-performance and maintainable — deployed and optimised for fast load times using modern web practices.',
    tags: ['Astro', 'React', 'Tailwind'],
    links: [{ label: 'case study →', href: ceEquipment?.link }],
  },
];
---

<section id="projects" class="w-full max-w-[1100px] mx-auto px-5 sm:px-10 pt-14 md:pt-[60px] pb-5">
  <div class="section-head">
    <span class="section-label">SVC / PROJECTS</span>
    <span class="font-bold text-[28px]">Deployments</span>
    <span class="font-mono text-[11px] text-faint sm:ml-auto">source available — review the code yourself</span>
  </div>

  <div class="grid sm:grid-cols-2 xl:grid-cols-4 gap-5">
    {deployments.map((project) => (
      <div class="node-card node-card-hover overflow-hidden flex flex-col">
        <div class="dark-bar px-[18px] py-2.5 font-mono text-[11px] gap-2">
          <span class="w-2 h-2 rounded-full bg-mint flex-none"></span>
          <span>{project.repo}</span>
          <span class="ml-auto text-inkmuted">{project.kind}</span>
        </div>
        <div class="px-[22px] py-5 flex-1 flex flex-col">
          <div class="font-bold text-xl mb-2">{project.name}</div>
          <div class="text-[13.5px] text-muted leading-[1.6] flex-1">{project.desc}</div>
          <div class="flex flex-wrap gap-1.5 mt-4 mb-3.5">
            {project.tags.map((tag) => (
              <span class="font-mono text-[10px] border border-ink rounded-full px-2.5 py-[3px]">{tag}</span>
            ))}
          </div>
          <div class="flex flex-wrap gap-x-4 gap-y-1">
            {project.links
              .filter((link) => link.href)
              .map((link) => (
                <a
                  href={link.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="font-mono text-[11px] text-accent font-bold hover:text-ink hover:underline"
                >
                  {link.label}
                </a>
              ))}
          </div>
        </div>
      </div>
    ))}
  </div>
</section>
