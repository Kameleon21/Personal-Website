---
---

<form
  action="https://api.web3forms.com/submit"
  method="POST"
  id="contact-form"
  class="needs-validation"
  data-astro-reload
  novalidate
  aria-label="Contact form">
  <input type="hidden" name="access_key" value="05b550d2-4a55-48ac-a936-b35068dbd9d6" />
  <input type="checkbox" class="hidden" style="display:none" name="botcheck" aria-hidden="true" tabindex="-1" />

  <div class="grid sm:grid-cols-2 gap-4 mb-4">
    <div>
      <input
        type="text"
        placeholder="your name"
        required
        class="brutal-input"
        name="name"
        id="name"
        aria-label="Your name"
        aria-required="true"
        aria-describedby="name-error"
      />
      <div id="name-error" class="empty-feedback invalid-feedback font-mono text-accent text-xs mt-1" role="alert">
        please provide your name.
      </div>
    </div>

    <div>
      <input
        type="email"
        placeholder="your email"
        required
        class="brutal-input"
        name="email"
        id="email"
        aria-label="Your email address"
        aria-required="true"
        aria-describedby="email-error email-invalid-error"
      />
      <div id="email-error" class="empty-feedback font-mono text-accent text-xs mt-1" role="alert">
        please provide your email address.
      </div>
      <div id="email-invalid-error" class="invalid-feedback font-mono text-accent text-xs mt-1" role="alert">
        please provide a valid email address.
      </div>
    </div>
  </div>

  <div class="mb-4">
    <textarea
      name="message"
      required
      placeholder="I'd like to discuss..."
      class="brutal-input h-36 resize-none"
      id="message"
      aria-label="Your message"
      aria-required="true"
      aria-describedby="message-error"
    ></textarea>
    <div id="message-error" class="empty-feedback invalid-feedback font-mono text-accent text-xs mt-1" role="alert">
      please enter your message.
    </div>
  </div>

  <button
    type="submit"
    class="font-mono text-xs font-bold bg-ghgreen text-white py-3 px-6 rounded-lg shadow-offset-sm hover:bg-ink transition-colors"
    aria-label="Send message"
  >
    POST /message
  </button>

  <div id="form-result" class="mt-4 hidden" role="status" aria-live="polite"></div>
</form>

<style>
  .invalid-feedback,
  .empty-feedback {
    display: none;
  }

  .was-validated :placeholder-shown:invalid ~ .empty-feedback {
    display: block;
  }

  .was-validated :not(:placeholder-shown):invalid ~ .invalid-feedback {
    display: block;
  }

  .is-invalid,
  .was-validated :invalid {
    border-color: #c2401b;
  }
</style>
