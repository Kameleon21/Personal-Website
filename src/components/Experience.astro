---
const diffLines = [
  { text: 'ships Spring Boot REST services across multiple apps' },
  { text: 'builds modular Angular front-end components' },
  { text: 'designs MySQL schemas for query efficiency' },
  { text: 'deploys via Docker + OpenShift, improves CI/CD' },
  { text: 'mentors(intern)', comment: '// onboarding, reviews, guidance' },
];
---

<section id="experience" class="w-full max-w-[1100px] mx-auto px-5 sm:px-10 pt-14 md:pt-[60px] pb-5">
  <div class="section-head">
    <span class="section-label">SVC / EXPERIENCE</span>
    <span class="font-bold text-[28px]">Deploy history</span>
    <span class="font-mono text-[11px] text-faint sm:ml-auto">0 incidents · 0 rollbacks</span>
  </div>

  <div class="grid md:grid-cols-[1.35fr_1fr] gap-5 items-start">
    <!-- Diff card -->
    <div class="node-card overflow-hidden !rounded-xl">
      <div class="dark-bar px-5 py-3">
        <span class="font-mono text-xs">experience/citi-dublin.java</span>
        <span class="font-mono text-[11px] text-mint ml-auto">+412 −0</span>
      </div>
      <div class="px-5 sm:px-6 py-5">
        <div class="flex flex-wrap justify-between items-baseline gap-x-4 mb-1.5">
          <span class="font-bold text-[19px]">Software Engineer — Citi Dublin</span>
          <span class="font-mono text-[11px] text-faint">2025.09 → now</span>
        </div>
        <div class="font-mono text-[12.5px] leading-8 mt-2.5">
          {diffLines.map((line) => (
            <div class="bg-diffbg px-3 rounded mb-[3px] last:mb-0">
              <span class="text-ghgreen">+</span> {line.text}
              {line.comment && <span class="text-[#8b949e]"> {line.comment}</span>}
            </div>
          ))}
        </div>
      </div>
    </div>

    <!-- Side cards -->
    <div class="flex flex-col gap-3.5">
      <div class="node-card px-5 py-[18px]">
        <div class="flex flex-wrap justify-between items-baseline gap-x-4">
          <span class="font-bold text-[15px]">SWE Intern — Citi Dublin</span>
          <span class="font-mono text-[10px] text-faint">2024.06 → 12</span>
        </div>
        <div class="text-[13px] text-muted leading-[1.55] mt-1.5">
          Java + .NET, APIs and microservices, Agile teams, code reviews. Converted to full-time.
        </div>
      </div>

      <div class="node-card px-5 py-[18px]">
        <div class="flex flex-wrap justify-between items-baseline gap-x-4">
          <span class="font-bold text-[15px]">BSc (Hons) Software Systems</span>
          <span class="font-mono text-[10px] text-faint">2022 → 25</span>
        </div>
        <div class="text-[13px] text-muted leading-[1.55] mt-1.5">
          SETU Waterford — First Class Honours (1.1).
        </div>
      </div>

      <div class="font-mono text-[11px] text-faint px-1">// languages: Polish (native) · English (fluent)</div>
    </div>
  </div>
</section>
