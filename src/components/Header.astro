---
const base = '/Personal-Website';
const routes = [
  { label: '/experience', href: `${base}/#experience` },
  { label: '/projects', href: `${base}/#projects` },
  { label: '/stack', href: `${base}/#stack` },
  { label: '/blog', href: `${base}/blog` },
];
---

<nav class="sticky top-0 z-[100] border-b-2 border-ink bg-paper/[.92] backdrop-blur-[6px]">
  <div class="flex justify-between items-center py-3.5 px-5 sm:px-10 relative">
    <a href={`${base}/`} class="font-mono text-[13px] font-bold text-ink relative z-[102]">
      kamil-system-design.md
    </a>

    <!-- Desktop Navigation -->
    <div class="hidden lg:flex gap-2 items-center">
      {routes.map((route) => (
        <a href={route.href} class="nav-route">{route.label}</a>
      ))}
      <a
        href={`${base}/#contact`}
        class="font-mono text-xs font-bold bg-accent text-white px-4 py-[7px] rounded-md shadow-offset-sm hover:bg-ink transition-colors ml-2"
      >
        POST /contact
      </a>
    </div>

    <!-- Hamburger Menu Button -->
    <button
      id="hamburger"
      class="lg:hidden flex flex-col justify-center items-center w-10 h-10 relative focus:outline-none z-[102] gap-1"
      aria-label="Menu"
      aria-expanded="false"
    >
      <div class="menu-line"></div>
      <div class="menu-line"></div>
      <div class="menu-line"></div>
    </button>

    <!-- Mobile Navigation Menu -->
    <div
      id="mobile-menu"
      class="fixed left-0 right-0 top-[58px] bg-paper border-b-2 border-ink z-[101] lg:hidden"
      aria-hidden="true"
      inert
    >
      <div class="flex flex-col px-5 py-4 gap-1">
        {routes.map((route) => (
          <a href={route.href} class="nav-route py-3 border-b border-dot">{route.label}</a>
        ))}
        <a
          href={`${base}/#contact`}
          class="font-mono text-xs font-bold bg-accent text-white px-4 py-3 rounded-md shadow-offset-sm text-center mt-3"
        >
          POST /contact
        </a>
      </div>
    </div>
  </div>
</nav>

<script>
  import { initMobileMenu } from '../scripts/header.js';

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initMobileMenu, { once: true });
  } else {
    initMobileMenu();
  }
</script>
