---
import ContactForm from './ContactForm.astro';
---

<section id="contact" class="max-w-[1100px] mx-auto px-5 sm:px-10 pt-16 md:pt-[70px] pb-4 w-full">
  <div class="bg-white border-2 border-ink rounded-[14px] overflow-hidden shadow-offset-lg">
    <!-- PR header -->
    <div class="dark-bar px-5 sm:px-7 py-4 gap-3 flex-wrap">
      <span class="bg-ghgreen text-white px-3 py-1 rounded-full font-mono text-[11px] font-bold whitespace-nowrap">⎇ Open</span>
      <span class="font-bold text-lg">Merge Kamil into your team <span class="text-faint font-normal">#2026</span></span>
      <span class="font-mono text-[11px] text-mint sm:ml-auto">+8,542 skills · −0 red flags</span>
    </div>

    <!-- Checks row -->
    <div class="px-5 sm:px-7 py-6 flex items-center gap-5 flex-wrap">
      <div class="flex-1 min-w-[260px]">
        <div class="flex items-center gap-2.5 mb-1.5">
          <span class="w-[26px] h-[26px] rounded-full bg-ghgreen text-white flex items-center justify-center text-[13px] flex-none">✓</span>
          <span class="font-bold text-base">All checks have passed — no conflicts with your team</span>
        </div>
        <div class="text-[13px] text-muted sm:pl-9">BSc (Hons) 1.1 · 2 yrs at Citi · 3 shipped projects · fluent EN / PL</div>
      </div>
      <div class="flex gap-2.5 items-center flex-wrap">
        <a
          href="https://github.com/Kameleon21"
          target="_blank"
          rel="noopener noreferrer"
          class="font-mono text-xs border-2 border-ink rounded-lg px-4 py-2.5 text-ink font-bold hover:bg-ink hover:text-paper transition-colors"
        >GitHub</a>
        <a
          href="https://www.linkedin.com/in/kamil-rogozinski/"
          target="_blank"
          rel="noopener noreferrer"
          class="font-mono text-xs border-2 border-ink rounded-lg px-4 py-2.5 text-ink font-bold hover:bg-ink hover:text-paper transition-colors"
        >LinkedIn</a>
        <a
          href="mailto:kamilrogozinski29@gmail.com"
          class="bg-ghgreen text-white font-bold text-[15px] px-6 py-3 rounded-lg shadow-offset-sm hover:bg-ink transition-colors"
        >Merge — get in touch</a>
      </div>
    </div>

    <!-- Comment box (contact form) -->
    <div class="border-t-2 border-ink px-5 sm:px-7 py-6 bg-paper/60">
      <div class="font-mono text-[11px] text-faint mb-4">// or leave a comment — opens a conversation</div>
      <ContactForm />
    </div>
  </div>
</section>

<script>
  import { initContactForm } from '../scripts/contact-form';

  document.addEventListener("DOMContentLoaded", initContactForm);
</script>
